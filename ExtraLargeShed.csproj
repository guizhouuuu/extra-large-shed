<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.0</Version>
    <AssemblyName>ExtraLargeShed</AssemblyName>
    <RootNamespace>ExtraLargeShed</RootNamespace>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>true</EnableModZip>
    <ModFolderName>ExtraLargeShed</ModFolderName>
    <ModZipPath>$(MSBuildProjectDirectory)/../packages</ModZipPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <Compile Remove="tests/**/*.cs" />
    <None Update="assets/**/*;i18n/**/*;README.md;REVIEW.md;TESTING.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
